  intro j
  by_cases h : j.val ∈ oldSupport
  · right
    have hn : j.val ∉ newSupport := fun hn => Finset.disjoint_left.mp supports_disjoint h hn
    intro i
    simp [newTable, hn]
  · left
    intro i
    simp [oldTable, h]

theorem row_map_valid : rowMap.length = 3698 ∧ rowMap.all (fun n => decide (n < 308)) = true := by decide

def rowIndex (i : Fin 3698) : Fin 308 :=
  Fin.ofNat 308 (rowMap.getD i.val 0)

def A (j : Fin 136) (i : Fin 3698) : ℝ := oldTable j (rowIndex i)
def B (j : Fin 136) (i : Fin 3698) : ℝ := newTable j (rowIndex i)

theorem actual_tables_pure : RussianDisplayed.Pure A B := by
  intro j
  rcases tables_pure j with h | h
  · exact Or.inl (fun i => h (rowIndex i))
  · exact Or.inr (fun i => h (rowIndex i))

theorem actual_positive_equals_current (lam : ℝ) (hl : 0 < lam) (t : Fin 3698 → ℝ) :
    (∃ w, (∀ j, 0 ≤ w j) ∧ ∀ i, RussianDisplayed.retained A B lam w i = t i) ↔
    (∃ w, (∀ j, 0 ≤ w j) ∧ ∀ i, RussianDisplayed.retained A B 1 w i = t i) := by
  exact RussianDisplayed.positive_family_equal A B actual_tables_pure lam 1 hl (by norm_num) t

theorem actual_expanded_equals_retained (lam : ℝ) (hl : 0 < lam) (t : Fin 3698 → ℝ) :
    (∃ u v, (∀ j, 0 ≤ u j) ∧ (∀ j, 0 ≤ v j) ∧
      ∀ i, RussianDisplayed.expanded A B u v i = t i) ↔
    (∃ w, (∀ j, 0 ≤ w j) ∧ ∀ i, RussianDisplayed.retained A B lam w i = t i) := by
  exact RussianDisplayed.expanded_family_equal A B actual_tables_pure lam hl t

end RussianFinite
