set_option maxHeartbeats 0
set_option maxRecDepth 100000
def UniqueAt (rows : List (List String)) (P : List String → ℝ) (g : List String) : Prop :=
  Generated rows g ∧ ∀ s, Generated rows s → P g≤P s ∧ (P s=P g → s=g)
theorem fixedAllCheckedG34a : fixedCheck uG34a 24 goalG34a [] rowsG34a=true := by
  apply fixedCheck_of_children
  intro x hx
  simp only [rowsG34a,List.mem_cons,List.mem_nil_iff,or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact fixedCheckedG34a_0
  · exact fixedCheckedG34a_1
  · exact fixedCheckedG34a_2
  · exact fixedCheckedG34a_3
  · exact fixedCheckedG34a_4
  · exact fixedCheckedG34a_5
  · exact fixedCheckedG34a_6
  · exact fixedCheckedG34a_7
  · exact fixedCheckedG34a_8
  · exact fixedCheckedG34a_9
  · exact fixedCheckedG34a_10
  · exact fixedCheckedG34a_11
  · exact fixedCheckedG34a_12
theorem fixedGoalG34a : fixedScore8 uG34a goalG34a=24 := by
  have h := fixedScore_bridge uG34a goalG34a
  rw [goal_score_G34a] at h
  norm_num [oldWeights,oldNatural] at h
  exact_mod_cast h.symm
theorem fixedUniqueG34a : UniqueAt rowsG34a (fullScore uG34a oldWeights (1/8)) goalG34a := by
  refine ⟨goal_generated_G34a,?_⟩
  intro s hs
  by_cases he : s=goalG34a
  · subst s; simp
  · have h := fixed_unique_of_check fixedAllCheckedG34a goal_generated_G34a fixedGoalG34a s hs he
    exact ⟨le_of_lt h,fun hx => False.elim ((ne_of_gt h) hx)⟩
