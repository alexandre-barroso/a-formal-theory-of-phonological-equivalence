theorem allcheckedG34a : check uG34a (3) (-2) outG34a [] rowsG34a=true := by
  apply check_of_children
  intro x hx
  simp only [rowsG34a,List.mem_cons,List.mem_nil_iff,or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact checkedG34a_0
  · exact checkedG34a_1
  · exact checkedG34a_2
  · exact checkedG34a_3
  · exact checkedG34a_4
  · exact checkedG34a_5
  · exact checkedG34a_6
  · exact checkedG34a_7
  · exact checkedG34a_8
  · exact checkedG34a_9
  · exact checkedG34a_10
  · exact checkedG34a_11
  · exact checkedG34a_12
theorem selectedG34a (l : ℝ) (h0 : 0≤l) (h1 : l<1/2) : Exclusive rowsG34a (fullScore uG34a (weightFamily l) l) outG34a := by
  apply selected_of_check allcheckedG34a goal_generated_G34a goal_observed_G34a _ l h0 h1
  intro t
  rw [goal_score_G34a]
  simp [weightFamily]
  <;> ring
