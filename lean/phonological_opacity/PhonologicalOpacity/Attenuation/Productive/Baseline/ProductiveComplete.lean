def Joint (w : Fin 9 → ℝ) (l : ℝ) : Prop :=
  Exclusive rowsG34a (fullScore uG34a w l) outG34a ∧
  Exclusive rowsG34b (fullScore uG34b w l) outG34b ∧
  Exclusive rowsN7 (fullScore uN7 w l) outN7 ∧
  Exclusive rowsG37c (fullScore uG37c w l) outG37c ∧
  Exclusive rowsC24ei (fullScore uC24ei w l) outC24ei ∧
  Exclusive rowsOR38 (fullScore uOR38 w l) outOR38 ∧
  Exclusive rowsC21b (fullScore uC21b w l) outC21b ∧
  Exclusive rowsC23UE (fullScore uC23UE w l) outC23UE
theorem exact_region (l : ℝ) (h0 : 0≤l) :
    (∃ w : Fin 9 → ℝ, (∀ k, 0≤w k) ∧ Joint w l) ↔ l<1/2 := by
  constructor
  · rintro ⟨w,hw,hs⟩
    exact necessary_bound w l (hw 4) hs.2.1 hs.2.2.2.1
  · intro h1
    exact ⟨weightFamily l,weightFamily_nonnegative l h0 h1,⟨selectedG34a l h0 h1,selectedG34b l h0 h1,selectedN7 l h0 h1,selectedG37c l h0 h1,selectedC24ei l h0 h1,selectedOR38 l h0 h1,selectedC21b l h0 h1,selectedC23UE l h0 h1⟩⟩
#print axioms exact_region
end ProductiveGua
