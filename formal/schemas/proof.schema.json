{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-order-phonology:proof:1.1.0",
  "title": "Neutral mathematical proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proof_id", "proof_method", "result_id", "proof_goal_id", "formal_statement_sha256", "claim", "claim_sha256", "assumptions_used", "foundation_dependencies", "result_dependencies", "payload"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "proof_id": {"type": "string", "minLength": 1},
    "proof_method": {"enum": ["FirstOrderProof", "BooleanTautologyProof", "FiniteEnumerationProof", "InductionProof", "RewriteChainProof", "PolynomialIdentityProof", "LaurentClearingProof", "IdealMembershipProof", "SumOfSquaresProof", "SemialgebraicUnsatProof", "ExactLinearAlgebraProof", "ConvexityProof", "KKTGlobalOptimalityProof", "LimitProof", "AsymptoticProof", "OpenPatchMeasureProof", "ConvexHullProof", "ComplexityReductionProof", "CounterexampleProof", "ExactDataReplayProof", "ExactFiniteComputationProof", "FiniteSemanticProof", "SemanticDerivationProof", "MaxEntSemanticClosureProof", "GeometricSeriesProof", "ExactApplicationProof", "TerminationMeasureProof", "LeanKernelProof"]},
    "result_id": {"type": "string", "minLength": 1},
    "proof_goal_id": {"type": "string", "minLength": 1},
    "formal_statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim": {"type": "object", "required": ["node"]},
    "claim_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assumptions_used": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "foundation_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "result_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "payload": {"type": "object"}
  },
  "$defs": {
    "finiteSemanticPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_kernel_version", "result_schema_id", "derivation_method", "derivation", "regression_algorithm", "regression_expected", "assumption_model", "assumption_model_result", "anti_vacuity", "mutant_ids"],
      "properties": {
        "semantic_kernel_version": {"const": "finite-semantics-1.0.0"},
        "result_schema_id": {"type": "string", "pattern": "^(CALC-F1|FIN-A[1-7])\\.FINITE-SCHEMA\\.1$"},
        "derivation_method": {"enum": ["universal_structural_derivation", "exact_finite_replay"]},
        "derivation": {"type": "array", "items": {"type": "object"}},
        "regression_algorithm": {"type": ["string", "null"]},
        "regression_expected": {},
        "assumption_model": {"type": "object"},
        "assumption_model_result": {"const": true},
        "anti_vacuity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conclusion_is_not_assumption", "assumption_count"],
          "properties": {
            "conclusion_is_not_assumption": {"const": true},
            "assumption_count": {"type": "integer", "minimum": 1}
          }
        },
        "mutant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "leanKernelProofPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_goal_id", "lean_declarations", "proof_goal_coverage_path", "proof_goal_coverage_sha256", "lean_toolchain_path", "lean_toolchain_sha256", "lake_manifest_path", "lake_manifest_sha256", "build_log_path", "build_log_sha256", "axiom_audit_log_path", "axiom_audit_log_sha256", "axiom_policy_log_path", "axiom_policy_log_sha256", "forbidden_token_log_path", "forbidden_token_log_sha256", "leanchecker_fresh_log_path", "leanchecker_fresh_log_sha256"],
      "properties": {
        "proof_goal_id": {"type": "string", "minLength": 1},
        "lean_declarations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "proof_goal_coverage_path": {"const": "lean/reports/proof_goal_coverage.tsv"},
        "proof_goal_coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lean_toolchain_path": {"const": "lean/lean-toolchain"},
        "lean_toolchain_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lake_manifest_path": {"const": "lean/lake-manifest.json"},
        "lake_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "build_log_path": {"const": "lean/logs/build.txt"},
        "build_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "axiom_audit_log_path": {"const": "lean/logs/axiom_audit.txt"},
        "axiom_audit_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "axiom_policy_log_path": {"const": "lean/logs/axiom_policy.txt"},
        "axiom_policy_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "forbidden_token_log_path": {"const": "lean/logs/forbidden_tokens.txt"},
        "forbidden_token_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "leanchecker_fresh_log_path": {"const": "lean/logs/leanchecker.txt"},
        "leanchecker_fresh_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"proof_method": {"const": "FiniteSemanticProof"}}, "required": ["proof_method"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/finiteSemanticPayload"}}}
    },
    {
      "if": {"properties": {"proof_method": {"const": "LeanKernelProof"}}, "required": ["proof_method"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/leanKernelProofPayload"}}}
    }
  ]
}
