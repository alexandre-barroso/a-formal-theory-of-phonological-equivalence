{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-order-phonology:result-spec:1.0.0",
  "title": "Canonical registered-result specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "title_en", "title_pt_BR", "kind", "group", "variables", "sorts", "domains", "definitions", "assumptions", "conclusion", "proof_goals", "quantifier_prefix", "registered_query_type", "scope", "nonclaims", "foundation_dependencies", "result_dependencies", "source_transcription_dependencies", "expected_proof_methods", "formal_statement_sha256", "english_statement_sha256", "portuguese_statement_sha256", "withdrawal_condition"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "result_id": {"type": "string", "pattern": "^[A-Z]+-[A-Z0-9]+$"},
    "title_en": {"type": "string", "minLength": 1},
    "title_pt_BR": {"type": "string", "minLength": 1},
    "kind": {"enum": ["result", "regression", "application", "data_demonstration"]},
    "group": {"enum": ["CALC", "FIN", "CHG", "CTX", "FLUX", "SUP", "SEL", "MAX", "APP", "DATA"]},
    "variables": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "sorts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "domains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "definitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "conclusion": {"$ref": "#/$defs/node"},
    "proof_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proof_goal_id", "mandatory", "claim", "proof_methods"],
        "properties": {
          "proof_goal_id": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "claim": {"$ref": "#/$defs/node"},
          "proof_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "quantifier_prefix": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "registered_query_type": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "nonclaims": {"type": "string", "minLength": 1},
    "foundation_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FOUND-"}},
    "result_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_transcription_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "expected_proof_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "formal_statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "english_statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "portuguese_statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "withdrawal_condition": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "record": {"type": "object"},
    "node": {"type": "object", "required": ["node"], "properties": {"node": {"type": "string", "minLength": 1}}}
  }
}
