{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/second-order-phonology/source-transcription.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "transcription_id": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bibtex_key", "filename", "sha256", "page_count", "anchors"],
        "properties": {
          "bibtex_key": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "pattern": "^[^/]+\\.pdf$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "page_count": {"type": "integer", "minimum": 1},
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["physical_pdf_page", "printed_page_or_section", "transcribed_role"],
              "properties": {
                "physical_pdf_page": {"type": "integer", "minimum": 1},
                "printed_page_or_section": {"type": "string", "minLength": 1},
                "transcribed_role": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "formal_objects": {"type": "object"},
    "source_claims": {"type": "array", "items": {"type": "string"}},
    "project_derived_uses": {"type": "array", "items": {"type": "string"}},
    "scope_ceiling": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "transcription_id", "source_artifacts", "formal_objects", "source_claims", "project_derived_uses", "scope_ceiling"]
}
