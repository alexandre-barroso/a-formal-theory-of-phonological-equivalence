root=Nest[DirectoryName,ExpandFileName[$InputFileName],3];
check[x_,name_]:=If[!TrueQ[x],Print["FAIL ",name];Exit[1]];
inputs=Sort[DeleteDuplicates[Flatten[Table[{a,b,t},{t,{1,3,4}},{a,{2,3}},{b,If[t==3,{2,3},{3,t}]}],2]]];
outputs=Tuples[Range[4],3];
coef[u_,v_,m_]:=Module[{a=ConstantArray[0,8],b=ConstantArray[0,8],rules,j,target,trigger,out,old,now,p},
 rules=Join[{{1,3,3,2},{2,1,1,3},{3,4,4,3}},If[m=="C",{{8,3,2,2}},{}]];
 Do[{j,target,trigger,out}=r;
  Do[old=u[[i]]==target&&u[[i+1]]==trigger;now=v[[i]]==target&&v[[i+1]]==trigger;
   p=v[[i]]!=out&&((m=="B"&&j==1)||v[[i+1]]==trigger);
   a[[j]]+=Boole[old&&p];b[[j]]+=Boole[!old&&now&&p],{i,2}],{r,rules}];
 a[[4]]=Count[MapThread[Unequal,{MemberQ[{1,4},#]&/@u,MemberQ[{1,4},#]&/@v}],True];
 a[[5]]=Count[MapThread[Unequal,{u,v}],True];
 a[[6]]=Sum[Boole[u[[i-1]]==u[[i]]&&u[[i]]!=v[[i]]],{i,2,3}];a[[7]]=Boole[u[[3]]!=v[[3]]];{a,b}];
py=Import[FileNameJoin[{root,"results","requirements","certificates","huaian_joint.json"}],"RawJSON"];
check[Length[inputs]==12&&Length[outputs]==64,"support"];
Do[check[coef[r["input"],r["output"],r["model"]]=={r["old"],r["new"]},"native_coefficients"],{r,py["coefficients"]}];
w={w33,w11,w44,reg,cont,right,final,w32};
cost[u_,v_,m_]:=With[{ab=coef[u,v,m]},(ab[[1]]+lambda ab[[2]]).w];
gap[u_,m_]:=Expand[cost[u,{2,2,3},m]-cost[u,{3,2,3},m]];
check[gap[{3,3,3},"A"]==cont&&gap[{3,2,3},"A"]==cont,"A"];
check[gap[{3,3,3},"B"]==cont-w33&&gap[{3,2,3},"B"]==cont,"B"];
check[gap[{3,3,3},"C"]==cont-lambda w32&&gap[{3,2,3},"C"]==cont-w32,"C"];
check[FullSimplify[1/(1+Exp[cont])<=1/2,cont>=0],"conditional_bound"];
check[Resolve[ForAll[{p,e},p<=1/2&&0<=e<=1/2, e+(1-2e)p<=1/2],Reals],"symmetric_noise"];
check[Resolve[ForAll[{p,fp,fn},p<=1/2&&fp+fn<=1,fp+(1-fp-fn)p<=(1+fp-fn)/2],Reals],"asymmetric_noise"];
out=<|"inputs"->Length[inputs],"candidates_per_input"->Length[outputs],"candidate_models"->Length[py["coefficients"]],"coefficient_values"->16 Length[py["coefficients"]],"symbolic_gaps"->6,"observation_inequalities"->3|>;
dest=FileNameJoin[{root,"results","requirements","wolfram","huaian_joint.json"}];
If[!DirectoryQ[DirectoryName[dest]],CreateDirectory[DirectoryName[dest],CreateIntermediateDirectories->True]];
Export[dest,out,"RawJSON"];Print[out];Exit[0];
