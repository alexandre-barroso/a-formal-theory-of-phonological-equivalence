root = NestWhile[ParentDirectory, DirectoryName[$InputFileName], !(DirectoryQ[FileNameJoin[{#, "python"}]] && DirectoryQ[FileNameJoin[{#, "wolfram"}]]) &, 1, 8];
outdir = FileNameJoin[{root, "results", "requirements", "wolfram"}];
If[!DirectoryQ[outdir], CreateDirectory[outdir, CreateIntermediateDirectories -> True]];
patterns=ImportString["{\"counterfeeding\": {\"kind\": \"schematic counterfeeding control\", \"alphabet\": {\"k\": [\"C\"], \"V\": [\"V\"], \"N\": [\"C\", \"N\"], \"T\": [\"C\", \"T\"]}, \"rules\": [[\"NDEL\", \"N\", [], [\"#\"], null], [\"TDEL\", \"T\", [\"N\"], [\"#\"], null]], \"mappings\": {\"kVN\": \"kV\", \"kVNT\": \"kVN\", \"kVNV\": \"kVNV\"}, \"options\": {\"N\": [\"N\", null], \"T\": [\"T\", null]}}, \"feeding\": {\"kind\": \"schematic reversal of the Catalan counterfeeding control\", \"alphabet\": {\"k\": [\"C\"], \"V\": [\"V\"], \"N\": [\"C\", \"N\"], \"T\": [\"C\", \"T\"]}, \"rules\": [[\"NDEL\", \"N\", [], [\"#\"], null], [\"TDEL\", \"T\", [\"N\"], [\"#\"], null]], \"mappings\": {\"kVN\": \"kV\", \"kVNT\": \"kV\", \"kVNV\": \"kVNV\"}, \"options\": {\"N\": [\"N\", null], \"T\": [\"T\", null]}}, \"counterbleeding\": {\"kind\": \"schematic counterbleeding control\", \"alphabet\": {\"k\": [\"C\", \"k\"], \"kj\": [\"C\"], \"i\": [\"V\", \"i\"], \"I\": [\"V\"], \"m\": [\"C\"], \"t\": [\"C\"], \"n\": [\"C\"], \"a\": [\"V\"]}, \"rules\": [[\"PAL\", \"k\", [], [\"i\"], \"kj\"], [\"SYNC\", \"i\", [], [\"C\", \"V\"], null]], \"mappings\": {\"kim\": \"kjim\", \"timIn\": \"tmIn\", \"kimIn\": \"kjmIn\"}, \"options\": {\"k\": [\"k\", \"kj\"], \"i\": [\"i\", null]}}, \"bleeding\": {\"kind\": \"schematic reversal of the Bedouin counterbleeding control\", \"alphabet\": {\"k\": [\"C\", \"k\"], \"kj\": [\"C\"], \"i\": [\"V\", \"i\"], \"I\": [\"V\"], \"m\": [\"C\"], \"t\": [\"C\"], \"n\": [\"C\"], \"a\": [\"V\"]}, \"rules\": [[\"PAL\", \"k\", [], [\"i\"], \"kj\"], [\"SYNC\", \"i\", [], [\"C\", \"V\"], null]], \"mappings\": {\"kim\": \"kjim\", \"timIn\": \"tmIn\", \"kimIn\": \"kmIn\"}, \"options\": {\"k\": [\"k\", \"kj\"], \"i\": [\"i\", null]}}, \"mutual_counterbleeding\": {\"kind\": \"schematic mutual counterbleeding control\", \"alphabet\": {\"g\": [\"C\"], \"a\": [\"V\"], \"h\": [\"C\", \"h\"], \"w\": [\"C\", \"w\"], \"u\": [\"V\"], \"t\": [\"C\"], \"d\": [\"C\"], \"r\": [\"C\"], \"e\": [\"V\"], \"m\": [\"C\"]}, \"rules\": [[\"HDEL\", \"h\", [], [\"C\"], null], [\"VOC\", \"w\", [\"C\"], [\"#\"], \"u\"]], \"mappings\": {\"gaht\": \"gat\", \"darw\": \"daru\", \"maw\": \"maw\", \"gahe\": \"gahe\", \"gahw\": \"gau\"}, \"options\": {\"h\": [\"h\", null], \"w\": [\"w\", \"u\"]}}, \"mutual_bleeding_h_first\": {\"kind\": \"schematic mutual bleeding h first control\", \"alphabet\": {\"g\": [\"C\"], \"a\": [\"V\"], \"h\": [\"C\", \"h\"], \"w\": [\"C\", \"w\"], \"u\": [\"V\"], \"t\": [\"C\"], \"d\": [\"C\"], \"r\": [\"C\"], \"e\": [\"V\"], \"m\": [\"C\"]}, \"rules\": [[\"HDEL\", \"h\", [], [\"C\"], null], [\"VOC\", \"w\", [\"C\"], [\"#\"], \"u\"]], \"mappings\": {\"gaht\": \"gat\", \"darw\": \"daru\", \"maw\": \"maw\", \"gahe\": \"gahe\", \"gahw\": \"gaw\"}, \"options\": {\"h\": [\"h\", null], \"w\": [\"w\", \"u\"]}}, \"mutual_bleeding_voc_first\": {\"kind\": \"schematic mutual bleeding voc first control\", \"alphabet\": {\"g\": [\"C\"], \"a\": [\"V\"], \"h\": [\"C\", \"h\"], \"w\": [\"C\", \"w\"], \"u\": [\"V\"], \"t\": [\"C\"], \"d\": [\"C\"], \"r\": [\"C\"], \"e\": [\"V\"], \"m\": [\"C\"]}, \"rules\": [[\"HDEL\", \"h\", [], [\"C\"], null], [\"VOC\", \"w\", [\"C\"], [\"#\"], \"u\"]], \"mappings\": {\"gaht\": \"gat\", \"darw\": \"daru\", \"maw\": \"maw\", \"gahe\": \"gahe\", \"gahw\": \"gahu\"}, \"options\": {\"h\": [\"h\", null], \"w\": [\"w\", \"u\"]}}, \"mutual_counterfeeding\": {\"kind\": \"hypothetical categorical paradigm; variable cases disputed\", \"alphabet\": {\"g\": [\"C\"], \"a\": [\"V\"], \"h\": [\"C\", \"h\"], \"r\": [\"C\"], \"@\": [\"@\", \"V\"], \"m\": [\"C\"], \"u\": [\"V\"], \"p\": [\"C\"], \"e\": [\"V\"], \"t\": [\"C\"]}, \"rules\": [[\"HDEL\", \"h\", [], [\"C\"], null], [\"SYNC\", \"@\", [\"C\", \"V\"], [\"C\", \"V\"], null]], \"mappings\": {\"gahe\": \"gahe\", \"gaht\": \"gat\", \"mae\": \"mae\", \"mat\": \"mat\", \"mar@mu\": \"marmu\", \"ah@pt\": \"ah@pt\", \"ah@pr@mu\": \"ah@pr@mu\", \"gahr@mu\": \"gar@mu\", \"ah@pe\": \"ahpe\"}, \"options\": {\"h\": [\"h\", null], \"@\": [\"@\", null]}}, \"fed_counterfeeding\": {\"kind\": \"schematic local context; Lardil reconstructed separately\", \"alphabet\": {\"C\": [\"C\", \"L\"], \"V\": [\"V\"], \"K\": [\"C\", \"K\"]}, \"rules\": [[\"APO\", \"V\", [\"C\", \"V\"], [\"#\"], null], [\"KDEL\", \"K\", [], [\"#\"], null]], \"mappings\": {\"CVCVCV\": \"CVCVC\", \"CVCVK\": \"CVCV\", \"CVCVKV\": \"CVCV\"}, \"options\": {\"V\": [\"V\", null], \"K\": [\"K\", null]}}, \"mutual_counterfeeding_deletions\": {\"kind\": \"hypothetical final deletion; block rival admits it\", \"alphabet\": {\"C\": [\"C\"], \"V\": [\"V\"]}, \"rules\": [[\"CDEL\", \"C\", [], [\"#\"], null], [\"VDEL\", \"V\", [], [\"#\"], null]], \"mappings\": {\"CVC\": \"CV\", \"CVCV\": \"CVC\"}, \"options\": {\"C\": [\"C\", null], \"V\": [\"V\", null]}}, \"noniterative_simultaneous\": {\"kind\": \"schematic noniterative simultaneous control\", \"alphabet\": {\"V\": [\"V\"], \"C\": [\"C\"], \"@\": [\"@\", \"V\"]}, \"rules\": [[\"SYNC\", \"@\", [\"C\", \"V\"], [\"C\", \"V\"], null]], \"mappings\": {\"VC@C@CV\": \"VCCCV\"}, \"options\": {\"@\": [\"@\", null]}}, \"noniterative_left_to_right\": {\"kind\": \"schematic noniterative left to right control\", \"alphabet\": {\"V\": [\"V\"], \"C\": [\"C\"], \"@\": [\"@\", \"V\"]}, \"rules\": [[\"SYNC\", \"@\", [\"C\", \"V\"], [\"C\", \"V\"], null]], \"mappings\": {\"VC@C@CV\": \"VCC@CV\"}, \"options\": {\"@\": [\"@\", null]}}, \"noniterative_right_to_left\": {\"kind\": \"schematic noniterative right to left control\", \"alphabet\": {\"V\": [\"V\"], \"C\": [\"C\"], \"@\": [\"@\", \"V\"]}, \"rules\": [[\"SYNC\", \"@\", [\"C\", \"V\"], [\"C\", \"V\"], null]], \"mappings\": {\"VC@C@CV\": \"VC@CCV\"}, \"options\": {\"@\": [\"@\", null]}}, \"self_counterfeeding\": {\"kind\": \"schematic self counterfeeding control\", \"alphabet\": {\"u\": [\"V\", \"rd\"], \"y\": [\"V\", \"y\"]}, \"rules\": [[\"RND\", \"y\", [\"rd\"], [], \"u\"]], \"mappings\": {\"uyy\": \"uuy\"}, \"options\": {\"y\": [\"y\", \"u\"]}}, \"self_feeding\": {\"kind\": \"schematic self feeding control\", \"alphabet\": {\"u\": [\"V\", \"rd\"], \"y\": [\"V\", \"y\"]}, \"rules\": [[\"RND\", \"y\", [\"rd\"], [], \"u\"]], \"mappings\": {\"uyy\": \"uuu\"}, \"options\": {\"y\": [\"y\", \"u\"]}}, \"self_counterbleeding\": {\"kind\": \"schematic self counterbleeding control\", \"alphabet\": {\"p\": [\"C\"], \"L\": [\"L\", \"V\"], \"s\": [\"C\"], \"v\": [\"C\"], \"a\": [\"V\"]}, \"rules\": [[\"SHORT\", \"L\", [\"C\", \"L\"], [], \"a\"]], \"mappings\": {\"pLsLvL\": \"pLsava\"}, \"options\": {\"L\": [\"L\", \"a\"]}}, \"self_bleeding\": {\"kind\": \"schematic self bleeding control\", \"alphabet\": {\"p\": [\"C\"], \"L\": [\"L\", \"V\"], \"s\": [\"C\"], \"v\": [\"C\"], \"a\": [\"V\"]}, \"rules\": [[\"SHORT\", \"L\", [\"C\", \"L\"], [], \"a\"]], \"mappings\": {\"pLsLvL\": \"pLsavL\"}, \"options\": {\"L\": [\"L\", \"a\"]}}, \"circular_chain_shift\": {\"kind\": \"schematic circular chain shift control\", \"alphabet\": {\"X\": [\"C\", \"X\"], \"Y\": [\"C\", \"Y\"], \"A\": [\"A\", \"V\"], \"B\": [\"B\", \"V\"], \"Q\": [\"Q\", \"V\"]}, \"rules\": [[\"AB\", \"A\", [\"X\"], [\"Y\"], \"B\"], [\"BQ\", \"B\", [\"X\"], [\"Y\"], \"Q\"], [\"QA\", \"Q\", [\"X\"], [\"Y\"], \"A\"]], \"mappings\": {\"XAY\": \"XBY\", \"XBY\": \"XQY\", \"XQY\": \"XAY\"}, \"options\": {\"A\": [\"A\", \"B\", \"Q\"], \"B\": [\"A\", \"B\", \"Q\"], \"Q\": [\"A\", \"B\", \"Q\"]}}, \"vipratisedha_blocking\": {\"kind\": \"schematic vipratisedha blocking control\", \"alphabet\": {\"i\": [\"V\", \"i\"], \"k\": [\"C\", \"k\"], \"kj\": [\"C\"], \"ts\": [\"C\"], \"a\": [\"V\"]}, \"rules\": [[\"PAL\", \"k\", [], [\"i\"], \"kj\"], [\"AFF\", \"k\", [\"i\"], [], \"ts\"]], \"mappings\": {\"aki\": \"akji\", \"ika\": \"itsa\", \"iki\": \"iki\"}, \"options\": {\"k\": [\"k\", \"kj\", \"ts\"]}}, \"vipratisedha_first_wins\": {\"kind\": \"schematic vipratisedha first wins control\", \"alphabet\": {\"i\": [\"V\", \"i\"], \"k\": [\"C\", \"k\"], \"kj\": [\"C\"], \"ts\": [\"C\"], \"a\": [\"V\"]}, \"rules\": [[\"PAL\", \"k\", [], [\"i\"], \"kj\"], [\"AFF\", \"k\", [\"i\"], [], \"ts\"]], \"mappings\": {\"aki\": \"akji\", \"ika\": \"itsa\", \"iki\": \"ikji\"}, \"options\": {\"k\": [\"k\", \"kj\", \"ts\"]}}, \"changtin\": {\"kind\": \"schematic reconstruction of source-reported Changtin\", \"alphabet\": {\"M\": [\"M\", \"V\"], \"R\": [\"R\", \"V\"], \"H\": [\"V\"], \"L\": [\"V\"]}, \"rules\": [[\"MR\", \"M\", [], [\"R\"], \"L\"], [\"RM\", \"R\", [], [\"M\"], \"H\"]], \"mappings\": {\"MR\": \"LR\", \"RM\": \"HM\", \"MRM\": \"LHM\", \"RMR\": \"HLR\"}, \"options\": {\"M\": [\"M\", \"L\"], \"R\": [\"R\", \"H\"]}}}","RawJSON"];
modes=<|"discharge"->{True,True},"retain"->{False,False},"ltr"->{True,False},"rtl"->{False,True}|>;
tokens[text_,alpha_]:=Module[{s=text,out={},syms=Reverse[SortBy[Keys[alpha],StringLength]],a},While[StringLength[s]>0,a=SelectFirst[syms,StringStartsQ[s,#]&];If[MissingQ[a],Print["token error"];Exit[2]];AppendTo[out,a];s=StringDrop[s,StringLength[a]]];out];
kand[x_]:=If[MemberQ[x,False],False,If[MemberQ[x,Null],Null,True]];
kor[x_]:=If[MemberQ[x,True],True,If[MemberQ[x,Null],Null,False]];
read[p_,s_,i_,rule_,mode_]:=Module[{left,right,ctx,lc,rc,ant,repair,q,carry,key},
 left=Select[Range[i-1,1,-1],s[[#]]=!=Null&];right=Select[Range[i+1,Length[s]],s[[#]]=!=Null&];
 ctx[indices_,decl_]:=And@@MapIndexed[Function[{c,pos},If[c==="#",Length[indices]<First[pos],Length[indices]>=First[pos]&&MemberQ[p["alphabet"][s[[indices[[First[pos]]]]]],c]]],decl];
 lc=ctx[left,rule[[3]]];rc=ctx[right,rule[[4]]];carry=modes[mode];
 ant=TrueQ[kand[{If[s[[i]]===Null,Null,MemberQ[p["alphabet"][s[[i]]],rule[[2]]]],lc,rc}]];
 repair=If[rule[[5]]===Null,s[[i]]===Null,If[s[[i]]===Null,Null,s[[i]]===rule[[5]]]];
 q=kor[{!((!carry[[1]]||lc)&&(!carry[[2]]||rc)),repair}];
 key=Join[If[carry[[1]],Table[If[j<=Length[left],left[[j]],Null],{j,Length[rule[[3]]]}],{}],If[carry[[2]],Table[If[j<=Length[right],right[[j]],Null],{j,Length[rule[[4]]]}],{}],{i}];
 {{ant,q=!=Null,TrueQ[q]},key}];
faiths[p_]:=Module[{pairs,cls,alpha=p["alphabet"]},pairs=({#[[2]],#[[5]]}&)/@p["rules"];
 Do[cls=If[MemberQ[alpha[s],s],s,First[Sort[alpha[s]]]];pairs=Join[pairs,({cls,#}&)/@DeleteCases[p["options"][s],s]],{s,Keys[p["options"]]}];
 Association[(If[#[[2]]===Null,"MAX_"<>#[[1]],"IDENT_"<>#[[1]]<>"_"<>#[[2]]]->#&)/@DeleteDuplicates[pairs]]];
coeff[p_,orig_,s_,ms_,subject_]:=Module[{out=<||>,before,marked,old,new,a,d,g,key,retained,rule,f},
 Do[rule=p["rules"][[j]];before=Table[read[p,orig,i,rule,ms[[j]]],{i,Length[orig]}];marked=Last/@Select[before,#[[1,1]]&&#[[1,2]]&&!#[[1,3]]&];old=0;new=0;
 Do[{{a,d,g},key}=read[p,s,i,rule,ms[[j]]];retained=If[subject,MemberQ[marked,key],before[[i,1,1]]&&before[[i,1,2]]&&!before[[i,1,3]]];old+=Boole[d&&!g&&retained];new+=Boole[d&&!g&&!retained&&a],{i,Length[s]}];out[rule[[1]]]={old,new},{j,Length[p["rules"]]}];
 f=faiths[p];Do[out[n]={Count[Table[MemberQ[p["alphabet"][orig[[i]]],f[n][[1]]]&&If[f[n][[2]]===Null,s[[i]]===Null,s[[i]]===f[n][[2]]],{i,Length[s]}],True],0},{n,Keys[f]}];KeySort[out]];
all={};systems={};
Do[p=patterns[name];Do[records={};ineqs={};names=Sort[Join[First/@p["rules"],Keys[faiths[p]]]];weights=Table[Symbol["ww"<>ToString[j]],{j,Length[names]}];
 Do[orig=tokens[inp,p["alphabet"]];cands=Tuples[(If[KeyExistsQ[p["options"],#],p["options"][#],{#}]&)/@orig];rows=Table[<|"candidate"->c,"surface"->StringJoin[DeleteCases[c,Null]],"baseline"->coeff[p,orig,c,ms,False],"subject"->coeff[p,orig,c,ms,True]|>,{c,cands}];AppendTo[records,<|"input"->inp,"target"->p["mappings"][inp],"rows"->rows|>],{inp,Keys[p["mappings"]]}];
 AppendTo[all,<|"pattern"->name,"modes"->ms,"records"->records|>];
 Do[per=Table[good=Select[item["rows"],#["surface"]===item["target"]&];bad=Select[item["rows"],#["surface"]=!=item["target"]&];Table[And@@Table[delta=Table[b[variant][n]-g[variant][n],{n,names}];Expand[(delta[[All,1]]+lam*delta[[All,2]]).weights]>0,{b,bad}],{g,good}],{item,records}];formula=And@@Thread[weights>=0]&&And@@(Or@@#&/@per);AppendTo[systems,<|"pattern"->name,"modes"->ms,"variant"->variant,"system"->With[{vars=weights,body=formula},Exists[vars,body]]|>],{variant,{"baseline","subject"}}],{ms,Tuples[Keys[modes],Length[p["rules"]]]}],{name,Keys[patterns]}];
unique=DeleteDuplicates[#["system"]&/@systems];regions=Table[TimeConstrained[Reduce[Resolve[sys,Reals]&&0<=lam<=1,lam,Reals],45,"TIMEOUT"],{sys,unique}];valid=AllTrue[regions,#=!= "TIMEOUT"&&FreeQ[#,_Reduce|_Resolve|_Exists|_ForAll]&&FreeQ[#,x_Symbol /; StringStartsQ[SymbolName[x],"ww"]]&];
Export[FileNameJoin[{outdir,"interaction_regions_coefficients.json"}],all,"RawJSON"];
labels=Table[<|"pattern"->x["pattern"],"modes"->x["modes"],"variant"->x["variant"],"system"->First@FirstPosition[unique,x["system"]],"region"->ToString[regions[[First@FirstPosition[unique,x["system"]]]],InputForm]|>,{x,systems}];
report=<|"assignments"->Length[all],"candidate_rows"->Total[Total[Length[#["rows"]]&/@#["records"]]&/@all],"systems"->Length[unique],"all_resolved"->valid,"regions"->labels|>;
Export[FileNameJoin[{outdir,"interaction_regions.json"}],report,"RawJSON"];

Print[KeyDrop[report,"regions"]];If[Length[all]==300&&valid,Exit[0],Exit[1]];
