root = NestWhile[ParentDirectory, DirectoryName[$InputFileName], !(DirectoryQ[FileNameJoin[{#, "python"}]] && DirectoryQ[FileNameJoin[{#, "wolfram"}]]) &, 1, 8];
outdir = FileNameJoin[{root, "results", "requirements", "wolfram"}];
If[!DirectoryQ[outdir], CreateDirectory[outdir, CreateIntermediateDirectories -> True]];
observations={{{"w","i","w","a","l","a"},{"w","i","w","a","l"}},{{"th","u","r","a","r","a","ŋ"},{"th","u","r","a","r","a"}},{{"ŋ","a","w","u","ŋ","a","w","u"},{"ŋ","a","w","u","ŋ","a"}}};
vowels={"a","i","u"};nonapical={"w","th","ŋ"};modes={{True,True},{False,False},{True,False},{False,True}};
read[s_,i_,rule_,mode_]:=Module[{pv,rs,p2,n,lc,rc,a,p,subject},
 pv=Select[Range[i-1,1,-1],MemberQ[vowels,s[[#]]]&];rs=Select[Range[i+1,Length[s]],s[[#]]=!=Null&];
 p2=If[Length[pv]>=2,pv[[2]],Null];n=If[Length[rs]>0,First[rs],Null];
 lc=If[rule==1,p2=!=Null,True];rc=n===Null;
 a=MemberQ[If[rule==1,vowels,nonapical],s[[i]]]&&lc&&rc;
 p=s[[i]]=!=Null&&(!mode[[1]]||lc)&&(!mode[[2]]||rc);
 subject=Join[If[mode[[1]]&&rule==1,{p2},{}],If[mode[[2]],{n},{}],{i}];{a,p,subject}];
coeff[original_,s_,mp_,useSubject_]:=Module[{out,before,subjects,a,p,key,old,new,ret},out=ConstantArray[0,{4,2}];
 Do[before=Table[read[original,i,rule,mp[[rule]]],{i,Length[s]}];subjects=Last/@Select[before,#[[1]]&&#[[2]]&];
 Do[{a,p,key}=read[s,i,rule,mp[[rule]]];ret=If[useSubject,MemberQ[subjects,key],before[[i,1]]&&before[[i,2]]];
 out[[rule,1]]+=Boole[p&&ret];out[[rule,2]]+=Boole[p&&!ret&&a],{i,Length[s]}],{rule,2}];
 Do[If[s[[i]]===Null&&MemberQ[vowels,original[[i]]],out[[3,1]]++];If[s[[i]]===Null&&MemberQ[nonapical,original[[i]]],out[[4,1]]++],{i,Length[s]}];out];
weights={a,k,mv,mk};systems={};allRecords={};
Do[records={};ineqBase={};ineqSubject={};
 Do[cands=Tuples[(If[MemberQ[Join[vowels,nonapical],#],{#,Null},{#}]&)/@pair[[1]]];
 rows=Table[{DeleteCases[c,Null],coeff[pair[[1]],c,mp,False],coeff[pair[[1]],c,mp,True]},{c,cands}];
 good=Select[rows,First[#]===pair[[2]]&];If[Length[good]!=1,Print["unexpected fiber"];Exit[2]];
 Do[If[First[row]=!=pair[[2]],delta=row[[2]]-good[[1,2]];AppendTo[ineqBase,Expand[(delta[[All,1]]+lam*delta[[All,2]]).weights]>0]];
 If[First[row]=!=pair[[2]],delta=row[[3]]-good[[1,3]];AppendTo[ineqSubject,Expand[(delta[[All,1]]+lam*delta[[All,2]]).weights]>0]],{row,rows}];
 AppendTo[records,<|"input"->pair[[1]],"target"->pair[[2]],"rows"->rows|>],{pair,observations}];
 AppendTo[allRecords,<|"modes"->mp,"records"->records|>];
 AppendTo[systems,<|"modes"->mp,"variant"->"baseline","inequalities"->Sort[DeleteDuplicates[ineqBase]]|>];
 AppendTo[systems,<|"modes"->mp,"variant"->"subject","inequalities"->Sort[DeleteDuplicates[ineqSubject]]|>],{mp,Tuples[modes,2]}];
unique=DeleteDuplicates[#["inequalities"]&/@systems];Print["distinct original systems: ",Length[unique]];
Export[FileNameJoin[{outdir,"lardil_region_coefficients.json"}],allRecords,"RawJSON"];
regions=Table[Print["eliminating ",i,"/",Length[unique]," with ",Length[unique[[i]]]," inequalities"];
 TimeConstrained[Reduce[Exists[{a,k,mv,mk},a>=0&&k>=0&&mv>=0&&mk>=0&&And@@unique[[i]]]&&0<=lam<=1,lam,Reals],45,"TIMEOUT"],{i,Length[unique]}];
exactChecks=Table[TrueQ[Resolve[ForAll[lam,Equivalent[regions[[First@FirstPosition[unique,x["inequalities"]]]],If[x["modes"][[1,1]],False,0<lam<1/2]]],Reals]],{x,systems}];
witness={1,2,1/2,lam*(1-2lam)/2};
witnessChecks=Table[If[x["modes"][[1,1]],True,TrueQ[Resolve[ForAll[lam,Implies[0<lam<1/2,And@@Join[Thread[witness>=0],x["inequalities"]/.Thread[weights->witness]]]],Reals]]],{x,systems}];
report=<|"modes"->16,"variants"->2,"candidate_records"->5120,"unique_systems"->Length[unique],"regions"->(ToString[#,InputForm]&/@regions),"exact_region_checks"->exactChecks,"parametric_witness_checks"->witnessChecks,"assignments"->Table[<|"modes"->s["modes"],"variant"->s["variant"],"system"->First@FirstPosition[unique,s["inequalities"]]|>,{s,systems}]|>;
Export[FileNameJoin[{outdir,"lardil_region.json"}],report,"RawJSON"];
Print[report];If[Length[systems]==32&&And@@exactChecks&&And@@witnessChecks,Exit[0],Exit[1]];
