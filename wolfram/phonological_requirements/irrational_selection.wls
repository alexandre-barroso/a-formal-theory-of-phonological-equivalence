ClearAll["Global`*"];
beta=Sqrt[2];
ind[b_]:=Boole[TrueQ[b]];
active[target_,p_,x_]:= x===target && p=!=None && p=!=target;
pressure[target_,p_,y_]:=p=!=None && p=!=target && y===target;
cell[a_,c_,p_]:=ind[a]ind[p]+(1-ind[a])ind[c]ind[p];
unary[x_,y_]:=Which[x===y,0,x===0&&y===1,1,True,beta];
local[rp_,cp_,x_,y_]:=unary[x,y]+8 Sum[cell[active[t,rp,x],active[t,cp,y],pressure[t,cp,y]],{t,0,1}];
truth=Flatten[Table[local[rp,cp,x,y]===unary[x,y]+If[cp===None||cp===y,0,8],{rp,{None,0,1}},{cp,{None,0,1}},{x,0,1},{y,0,1}]];
If[!And@@truth,Quit[1]];
score[u_,v_]:=Sum[unary[u[[j]],v[[j]]],{j,Length[u]}]+8 Count[Partition[v,2,1],{x_,y_}/;x=!=y];
dp[u_]:=Min[Fold[Function[{d,x},{Min[d[[1]],d[[2]]+8]+unary[x,0],Min[d[[2]],d[[1]]+8]+unary[x,1]}],{0,0},u]];
word[n_]:=Flatten[Table[Join[{1},ConstantArray[0,Floor[j beta]-Floor[(j-1) beta]]],{j,n}]];
bal[u_]:=beta Count[u,1]-Count[u,0];
str[u_]:=StringJoin[(If[#==0,"a","b"]&)/@u];
coef[v_]:={v-Coefficient[v,beta]beta,Coefficient[v,beta]};
records={};count=0;
Do[Do[vals=Table[score[u,v],{v,Tuples[{0,1},n]}];best=Min@@vals;If[!TrueQ[FullSimplify[dp[u]==best]],Quit[2]];
winners=Pick[Tuples[{0,1},n],(TrueQ[FullSimplify[#==best]]&)/@vals];
AppendTo[records,<|"input"->str[u],"min"->coef[Expand[best]],"winners"->(str/@winners)|>];count+=Length[vals],{u,Tuples[{0,1},n]}],{n,0,6}];
stable=FullSimplify[{Min[a,b+8]==a,Min[b,a+8]==b},Element[{a,b},Reals]&&-8<=a-b<=8];
threshold=FullSimplify[{Min[az+r,bz]==az+r,Min[az+s,bz]==bz,az+r<bz},Element[{az,bz,r,s,t},Reals]&&az-bz==t&&-s<t<-r];
If[!And@@Join[stable,threshold],Quit[3]];
r=Table[bal[word[n]],{n,0,64}];
If[Length[DeleteDuplicates[r]]!=65,Quit[4]];
If[!And@@(TrueQ[FullSimplify[0<#<1]]&/@Rest[r]),Quit[5]];
output=<|"all_pass"->True,"native_local_cells"->Length[truth],"candidate_scores"->count,"complete_argmins"->Length[records],"stable_symbolic_identities"->stable,"threshold_symbolic_identities"->threshold,"distinct_radical_residues"->65,"complete_minimizers"->records|>;
out=FileNameJoin[{DirectoryName[DirectoryName[DirectoryName[$InputFileName]]],"results","requirements","wolfram","irrational_selection.json"}];
If[!DirectoryQ[DirectoryName[out]],CreateDirectory[DirectoryName[out],CreateIntermediateDirectories->True]];
Export[out,output,"RawJSON"];
Print[KeyDrop[output,"complete_minimizers"]];Quit[0];
