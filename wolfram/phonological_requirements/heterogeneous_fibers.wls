ClearAll["Global`*"];
out = FileNameJoin[{DirectoryName[DirectoryName[DirectoryName[$InputFileName]]], "results", "requirements", "wolfram", "heterogeneous_fibers.json"}];
If[!DirectoryQ[DirectoryName[out]], CreateDirectory[DirectoryName[out], CreateIntermediateDirectories -> True]];
checks = <||>;
checks["running_minimum_local"] = TimeConstrained[Reduce[r <= b && !(Max[r - Min[r, x], 0] <= Max[b - x, 0]), {r, b, x}, Reals] === False, 30, "TIMEOUT"];
checks["positive_power_derivative"] = TimeConstrained[FullSimplify[D[z^p,z] > 0, Assumptions -> p > 1 && z > 0], 15, "TIMEOUT"];
checks["positive_power_zero_endpoint"] = TimeConstrained[FullSimplify[0^p == 0 && z^p > 0, Assumptions -> p > 1 && z > 0], 15, "TIMEOUT"];
dd = Array[d, 5]; mm = Array[m, 5];
xx = Prepend[1 - Accumulate[dd], 1];
checks["profile_cumulative_identity"] = Expand[Sum[mm[[i]] xx[[i+1]], {i,5}] - Total[mm] + Sum[Total[mm[[i;;]]] dd[[i]], {i,5}]] === 0;
checks["component_gap_fiber"] = TimeConstrained[Reduce[h > 0 && m >= 0 && n >= 0 && a >= 0 && b >= 0 && c >= 0 && d >= 0 && Not[Equivalent[h (a+b)+m c+n d == 0, a == 0 && b == 0 && (m == 0 || c == 0) && (n == 0 || d == 0)]], {h,m,n,a,b,c,d}, Reals] === False,30,"TIMEOUT"];
vv = Array[v,5];
obj = Sum[h (dd[[i]]+t vv[[i]])^p - Total[mm[[i;;]]] (dd[[i]]+t vv[[i]]),{i,5}];
checks["reduced_directional_derivative"] = TimeConstrained[FullSimplify[(D[obj,t] /. t -> 0) == Sum[(p h dd[[i]]^(p-1)-Total[mm[[i;;]]]) vv[[i]], {i,5}], Assumptions -> p > 1 && And @@ Thread[dd > 0]],15,"TIMEOUT"];
checks["power_derivative_zero_boundary"] = TimeConstrained[Limit[p z^(p-1), z -> 0, Direction -> "FromAbove", Assumptions -> p > 1] === 0,15,"TIMEOUT"];
e3 = Max[1-x,0]^2 + Max[x-y,0]^2 + Max[y-z,0]^2;
int = TimeConstrained[Reduce[0 <= x <= 1 && 0 <= y <= 1 && 0 <= z <= 1 && e3 + 2 x + 2 z == 1, {x,y,z}, Reals], 15, "TIMEOUT"];
end = TimeConstrained[Reduce[0 <= x <= 1 && 0 <= y <= 1 && 0 <= z <= 1 && e3 + 2 x + 2 y == 1, {x,y,z}, Reals], 15, "TIMEOUT"];
checks["zero_interior_does_not_force_nonuniqueness"] = If[int === "TIMEOUT", "TIMEOUT", TimeConstrained[Reduce[Xor[int, x == 0 && y == 0 && z == 0], {x,y,z}, Reals] === False,15,"TIMEOUT"]];
checks["zero_suffix_complete_tie_fiber"] = If[end === "TIMEOUT", "TIMEOUT", TimeConstrained[Reduce[Xor[end, x == 0 && y == 0 && 0 <= z <= 1], {x,y,z}, Reals] === False,15,"TIMEOUT"]];
result = <|"checks" -> Map[If[BooleanQ[#], #, ToString[#,InputForm]]&,checks], "expected_checks" -> 9, "passed_checks" -> Count[Values[checks], True], "interior_zero_fiber" -> ToString[int, InputForm], "terminal_zero_fiber" -> ToString[end,InputForm], "scope" -> "Independent local and symbolic certificates; universal finite-horizon transport and optimizer statement checked in Lean."|>;
Export[out,result,"RawJSON"];
Print[InputForm[result]];
If[Length[checks] != 9 || !And @@ (TrueQ /@ Values[checks]), Exit[1]];
