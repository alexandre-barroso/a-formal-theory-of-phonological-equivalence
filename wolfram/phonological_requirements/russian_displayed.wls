root = DirectoryName[DirectoryName[DirectoryName[$InputFileName]]];
j = Import[FileNameJoin[{root,"results","requirements","certificates","russian_displayed_matrices.json"}],"RawJSON"];
a = j["A"]; b = j["B"];
pure = And @@ Table[AllTrue[a[[All,k]], # == 0 &] || AllTrue[b[[All,k]], # == 0 &], {k,136}];
factors = Table[If[AllTrue[a[[All,k]], # == 0 &], lam/mu, 1], {k,136}];
identities = Table[Cancel[a[[i,k]]+lam b[[i,k]]-factors[[k]] (a[[i,k]]+mu b[[i,k]])] == 0, {i,308},{k,136}];
nonnegative = FullSimplify[And @@ Thread[factors >= 0], Assumptions -> lam > 0 && mu > 0];
ranks = {MatrixRank[a],MatrixRank[a+b/4],MatrixRank[a+b],MatrixRank[Join[a,b,2]]};
cx = {1/5,49/40,49/20,129/40}; cy = {1/20,43/40,19/8,123/40};
px = Exp[-cx]/Total[Exp[-cx]]; py = Exp[-cy]/Total[Exp[-cy]];
odds = FullSimplify[px[[4]]/px[[1]] == py[[4]]/py[[1]]];
gap = N[Abs[px[[1]]-py[[1]]],30];
normal = FullSimplify[Total[px] == 1 && Total[py] == 1];
sampling = FullSimplify[(s1 p1/(s0 p0+s1 p1))/(s0 p0/(s0 p0+s1 p1)) == s1 p1/(s0 p0), Assumptions -> s1>0 && s0>0 && p1>0 && p0>0];
q = 1/(1+Exp[-eta]);
scoreGradient = FullSimplify[D[Log[1+Exp[eta]]-y eta,eta] == q-y, Assumptions -> Element[{eta,y},Reals]];
scoreHessian = FullSimplify[D[Log[1+Exp[eta]]-y eta,{eta,2}] == q(1-q), Assumptions -> Element[{eta,y},Reals]];
pairOdds = FullSimplify[Exp[alpha + d]/Exp[alpha + f] == Exp[d-f], Assumptions -> Element[{alpha,d,f},Reals]];
ok = pure && And@@Flatten[identities] && TrueQ[nonnegative] && ranks=={12,54,54,54} && TrueQ[odds] && gap>1/1000 && TrueQ[normal] && TrueQ[sampling] && TrueQ[scoreGradient] && TrueQ[scoreHessian] && TrueQ[pairOdds];
out = <|"status" -> If[TrueQ[ok],"PASS","FAIL"],"coefficient_identities" -> Length[Flatten[identities]],"pure_columns" -> pure,"positive_scaling" -> nonnegative,"ranks" -> ranks,"equal_displayed_odds" -> odds,"normalized_law_gap" -> gap,"normalization" -> normal,"selection_odds_identity" -> sampling,"binary_score_gradient" -> scoreGradient,"binary_score_hessian" -> scoreHessian,"discordant_pair_odds" -> pairOdds|>;
dir = FileNameJoin[{root,"results","requirements","wolfram"}];If[!DirectoryQ[dir],CreateDirectory[dir,CreateIntermediateDirectories->True]];
Export[FileNameJoin[{dir,"russian_displayed.json"}],out,"RawJSON"];Print[out];If[!TrueQ[ok],Exit[1]];
