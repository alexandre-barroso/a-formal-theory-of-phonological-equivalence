base=DirectoryName[DirectoryName[DirectoryName[$InputFileName]]];
check[x_,label_]:=If[!TrueQ[x],Print["FAILED ",label];Exit[1]];
profiles={{0,0},{0,1},{1,0}};
lex[a_,b_]:=a[[1]]<b[[1]]||(a[[1]]==b[[1]]&&a[[2]]<b[[2]]);
ord[rank_]:=Select[Tuples[Range[0,2],2],lex[profiles[[#[[1]]+1,rank]],profiles[[#[[2]]+1,rank]]]&];
src=ord[{1,2}];tgt=ord[{2,1}];
changed=Select[Tuples[Range[0,2],2],MemberQ[src,#]=!=MemberQ[tgt,#]&];
check[src=={{0,1},{0,2},{1,2}}&&tgt=={{0,1},{0,2},{2,1}},"orders"];
check[changed=={{1,2},{2,1}}&&DeleteDuplicates[Sort/@changed]=={{1,2}},"both orientations"];
win[dom_,edges_]:=Select[dom,Function[x,!AnyTrue[edges,Function[e,MemberQ[dom,e[[1]]]&&e[[2]]==x]]]];
check[win[Range[0,2],src]=={0}&&win[Range[0,2],tgt]=={0},"winners"];
laws={{4,2,1}/7,{16,4,1}/21,{4,2}/6};
check[Total/@laws=={1,1,1}&&laws[[1,1]]!=laws[[2,1]]&&laws[[1,1]]!=laws[[3,1]],"normalization"];
check[win[{0,1},src]=={0},"deletion"];
Get[FileNameJoin[{base,"wolfram","phonological_opacity","gua","model.wl"}]];
Get[FileNameJoin[{base,"wolfram","phonological_opacity","gua","GuaData.wl"}]];
input=SelectFirst[inputsSelection,#["id"]=="G34a"&];
origin=Lookup[input["slots"],"phone"];words=Lookup[input["slots"],"word"];focal=input["focal"]+1;phrases=input["phrases"];
alpha=grammar["alphabet"];inv=grammar["inventory"];origft=ft/@origin;
r0=readState[origin];prior=Table[MapThread[And[#1,#2,Not[#3]]&,{r0[[1,k]],r0[[2,k]],r0[[3,k]]}],{k,9}];
weights={20,1,1,2,4,8,8,24,1};indices={566,774,605};
rows=Table[s=expandState[IntegerDigits[i,13,3]];co=coefficientsState[s];
 terms=Table[weights[[k]]If[5<=k<=8,co[[k,1]]+co[[k,2]]/8,co[[k,3]]],{k,9}];
 {i,realizeState[s],{Total[terms[[{1,2,3,4,9}]]],terms[[5]],terms[[6]],Total[terms]},co[[5;;8,3]]},{i,indices}];
check[rows[[All,3]]=={{0,4,8,12},{3,0,0,3},{2,4,0,6}},"native opening scores"];
check[rows[[2,4]]==rows[[3,4]]=={0,0,0,0},"current equality"];
check[Reduce[2+common>=3+common,common,Reals]===False,"fixed faithfulness strict bound"];
Print["PASS: orders, both orientations, laws, native Gua rows and symbolic fixed-faithfulness obstruction; Wolfram ",$Version];
